##############################################################################
# SIFAT LIBRARY — Production Environment Variables
# Bu faylni .env.prod ga nusxalab barcha qiymatlarni to'ldiring.
# HECH QACHON bu faylni git ga commitmang (allaqachon .gitignore da).
##############################################################################

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
NEXT_PUBLIC_API_URL=https://api.sifat.uz

# ── Database (PostgreSQL + PgBouncer + Replica) ──────────────────────────────
# Plan 01-06 INFRA-09/10. App queries pool through PgBouncer in transaction
# mode. `?pgbouncer=true&connection_limit=1` is REQUIRED by Prisma to disable
# its prepared-statement caching (RESEARCH PITFALLS Pitfall 4).
DATABASE_URL=postgresql://sifat:STRONG_PASSWORD@pgbouncer:6432/sifat?pgbouncer=true&connection_limit=1
# Migrations bypass the pooler — Prisma `directUrl` points here so DDL
# (prepared statements) lands on a real Postgres session.
DIRECT_DATABASE_URL=postgresql://sifat:STRONG_PASSWORD@postgres:5432/sifat?schema=public
# Streaming-replication standby. Only for analytics / leaderboard reads —
# never auth or transactional reads (replication lag -> read-after-write
# bugs; T-06-04 mitigation). App-side read-routing wiring is deferred to
# Phase 2/5; this plan only provisions the infrastructure + URL.
DATABASE_REPLICA_URL=postgresql://sifat:STRONG_PASSWORD@postgres-replica:5432/sifat?schema=public
DB_NAME=sifat
DB_USER=sifat
DB_PASSWORD=STRONG_DB_PASSWORD_HERE
# Streaming-replication role used by the postgres-replica service for
# pg_basebackup + WAL streaming. Must NOT be the same as DB_PASSWORD.
DB_REPLICATION_USER=replicator
DB_REPLICATION_PASSWORD=STRONG_REPLICATION_PASSWORD_HERE

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:STRONG_REDIS_PASSWORD@redis:6379
REDIS_PASSWORD=STRONG_REDIS_PASSWORD_HERE

# ── Elasticsearch ────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://elastic:ELASTIC_PASS@elasticsearch:9200
ELASTIC_PASSWORD=STRONG_ELASTIC_PASSWORD_HERE

# ── JWT ──────────────────────────────────────────────────────────────────────
# openssl rand -hex 64
JWT_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_64
JWT_REFRESH_SECRET=GENERATE_ANOTHER_OPENSSL_RAND_HEX_64

# ── SMS (Eskiz.uz) ───────────────────────────────────────────────────────────
SMS_API_KEY=YOUR_ESKIZ_API_KEY
SMS_EMAIL=your@email.com
SMS_FROM=SIFAT

# ── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=sifat-backend
KAFKA_GROUP_ID=sifat-consumers

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_USER=STRONG_MINIO_USER
MINIO_PASSWORD=STRONG_MINIO_PASSWORD
MINIO_BUCKET=sifat-files
# Backend MinIO klienti (minio.service.ts) shu nomlarni o'qiydi; MINIO_USER /
# MINIO_PASSWORD esa minio konteyneriniki — qiymatlar bir xil bo'lsin.
MINIO_ACCESS_KEY=STRONG_MINIO_USER
MINIO_SECRET_KEY=STRONG_MINIO_PASSWORD
MINIO_BUCKET_DEBATES=debate-media
MINIO_BUCKET_BOOKCORNERS=bookcorner-photos
MINIO_BUCKET_READINGHOURS=readinghour-media

# ── Payme ────────────────────────────────────────────────────────────────────
PAYME_MERCHANT_ID=YOUR_PAYME_MERCHANT_ID
PAYME_SECRET_KEY=YOUR_PAYME_SECRET_KEY
# Payme sandbox ("Paycom" login) kaliti — PRODUCTION_REQUIRED_ENV da bor, bo'sh
# qoldirilsa sandbox-auth tarmog'i o'chadi (payme.service FIX 3), boot yiqilmaydi.
PAYME_LOGIN=Paycom
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

# ── Click ────────────────────────────────────────────────────────────────────
CLICK_MERCHANT_ID=YOUR_CLICK_MERCHANT_ID
CLICK_SERVICE_ID=YOUR_CLICK_SERVICE_ID
CLICK_SECRET_KEY=YOUR_CLICK_SECRET_KEY

# ── HashiCorp Vault (INFRA-04) ───────────────────────────────────────────────
# Prod'da majburiy — dev-root-token fallback bekor qilingan. Backend boot'da
# ikkalasi bo'lmasa process yiqiladi (production-env.util.ts).
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=YOUR_VAULT_TOKEN

# ── OneID / ID.UZ OAuth2.0 (sso.egov.uz) ─────────────────────────────────────
# Plan 01-06 AUTH-03: Official OneID provider is sso.egov.uz with non-standard
# .do grant flow (one_authorization_code / one_access_token_identify).
# Prod boot WILL FAIL if IDUZ_CLIENT_ID/SECRET are empty (no dev fallback).
IDUZ_BASE_URL=https://sso.egov.uz
IDUZ_CLIENT_ID=YOUR_IDUZ_CLIENT_ID
IDUZ_CLIENT_SECRET=YOUR_IDUZ_CLIENT_SECRET
IDUZ_REDIRECT_URI=https://sifat.uz/auth/iduz/callback

# ── Mutolaa API ──────────────────────────────────────────────────────────────
MUTOLAA_API_URL=https://api.mutolaa.uz
MUTOLAA_WEBHOOK_SECRET=YOUR_MUTOLAA_WEBHOOK_SECRET

# ── Firebase (Push) ──────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.your-provider.uz
SMTP_PORT=587
SMTP_USER=noreply@sifat.uz
SMTP_PASSWORD=STRONG_SMTP_PASSWORD
SMTP_FROM="SIFAT LIBRARY <noreply@sifat.uz>"
# Backend mail klienti SMTP_PASS nomini o'qiydi (SMTP_PASSWORD — Grafana uchun);
# ikkalasi bir xil qiymat.
SMTP_PASS=STRONG_SMTP_PASSWORD

# ── Eskiz SMS (OTP) — prod boot'da majburiy ─────────────────────────────────
ESKIZ_EMAIL=your-eskiz-account@example.com
ESKIZ_PASSWORD=YOUR_ESKIZ_PASSWORD

# ── Firebase Cloud Messaging (push) — prod boot'da majburiy ─────────────────
# Service-account JSON konteynerga secret/volume sifatida mount qilinadi.
FCM_SERVICE_ACCOUNT_KEY_PATH=/run/secrets/fcm-service-account.json

# ── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN_BACKEND=https://xxx@sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# ── Monitoring ───────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=STRONG_GRAFANA_PASSWORD

# ── Do'kon secretlari (har do'kon uchun alohida) ─────────────────────────────
# STORE_SECRET_<store_id>=secret_value
# Prod da HashiCorp Vault ishlatiladi

# ── AI (ixtiyoriy, Sprint 8) ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
PINECONE_API_KEY=...
PINECONE_ENVIRONMENT=...
PINECONE_INDEX=sifat-books

# ── Registry (Docker image) ──────────────────────────────────────────────────
REGISTRY=ghcr.io/sifat-library
VERSION=1.0.0
