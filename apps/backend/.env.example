DATABASE_URL="postgresql://sifat:sifat@localhost:55432/sifat?schema=public"
# Plan 01-06 INFRA-09: Prisma migrations bypass PgBouncer via a DIRECT
# Postgres connection (transaction-mode pool breaks DDL prepared statements).
# In local dev there is no pooler, so this mirrors DATABASE_URL.
# In prod (.env.prod) DATABASE_URL routes via pgbouncer:6432?pgbouncer=true
# and DIRECT_DATABASE_URL targets postgres:5432 directly.
DIRECT_DATABASE_URL="postgresql://sifat:sifat@localhost:55432/sifat?schema=public"
# Plan 01-06 INFRA-10: Read replica for analytics / leaderboard queries
# ONLY. Never route auth or transactional reads here (replication lag ->
# read-after-write bugs). App-side routing wiring is deferred to Phase 2/5.
DATABASE_REPLICA_URL="postgresql://sifat:sifat@localhost:55432/sifat?schema=public"
REDIS_URL="redis://localhost:56379"
ELASTICSEARCH_NODE="http://localhost:9200"

# JWT
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-refresh-in-production"

# SMS (Eskiz.uz yoki SMS.uz)
SMS_PROVIDER_TOKEN="your-sms-token"
SMS_PROVIDER_URL="https://notify.eskiz.uz/api"

DEV_OTP_BYPASS=false  # DEV ONLY — when 'true' AND NODE_ENV!=='production', skips OTP send/verify. Hard production guard inside AuthService. Set to 'false' (or unset) to use live Eskiz OTP.

DEV_DONATION_PAYMENT_STUB=false  # DEV ONLY (Plan 03-01 D-DONAT-01) — when 'true' AND NODE_ENV in {development,test,dev}, donation initiate returns a stub success URL and the webhook auto-completes without real Payme/Click HMAC. Fail-CLOSED in production: boot throws if this is 'true' with NODE_ENV=production. Real Payme/Click integration lands in Phase 4 PAY-01..08.

DEV_SUBSCRIPTION_PAYMENT_STUB=false  # DEV ONLY (Plan 04-01 OQ-6) — same allowlist/semantics as DEV_DONATION_PAYMENT_STUB but for SUBSCRIPTION invoice webhooks (Payme/Click). When 'true' AND NODE_ENV in {development,test,dev}, Payme/Click subscription webhook handlers short-circuit to synthetic success without verifying HMAC. Fail-CLOSED in production: boot throws if this is 'true' with NODE_ENV=production.

# Mutolaa.uz webhook imzo kaliti (server-to-server)
MUTOLAA_WEBHOOK_SECRET="change-me-mutolaa-secret"

# Payme (Plan 04-01 PAY-01)
PAYME_MERCHANT_ID="your-merchant-id"
PAYME_SECRET_KEY="your-payme-secret"
PAYME_TEST_KEY="your-payme-test-key"
# PAYME_LOGIN: Basic Auth username Payme sends in webhook Authorization header.
# Sandbox value is literally "Paycom"; production value is provided by Payme on
# merchant activation (per OQ-5). Required in prod — boot throws if missing.
PAYME_LOGIN="Paycom"
# PAYME_IP_WHITELIST: CSV of Payme callback source IPs. Payme does NOT publish
# their IP ranges in public docs (per OQ-2) — operator obtains them from the
# Payme integration team and pastes here for production. Empty in dev = no
# whitelist enforced (IpWhitelistGuard permissive default). See
# https://developer.help.paycom.uz/
PAYME_IP_WHITELIST=

# Click (Plan 04-01 PAY-02)
CLICK_MERCHANT_ID="your-merchant-id"
CLICK_SECRET_KEY="your-click-secret"
# CLICK_SERVICE_ID: operator-supplied per OQ-5; required in prod. Used inside
# the HMAC signature formula (md5(click_trans_id + service_id + SECRET_KEY +
# merchant_trans_id + [merchant_prepare_id?] + amount + action + sign_time)).
CLICK_SERVICE_ID=
# CLICK_IP_WHITELIST: CSV of Click callback source IPs. Click publishes these
# in the merchant cabinet (not in public docs). Empty in dev = permissive.
# See https://docs.click.uz/
CLICK_IP_WHITELIST=

# Sentry
SENTRY_DSN=""

# OneID (sso.egov.uz) — Davlat foydalanuvchilari uchun OAuth2.0 + PKCE
# Plan 01-06 AUTH-03. Prod muhitda IDUZ_CLIENT_ID/SECRET majburiy (defaultsiz fail).
# Live integratsiya hali tasdiqlanmagan — Plan 01-06 Task 2 (human-verify) bajariladi.
IDUZ_BASE_URL="https://sso.egov.uz"
IDUZ_CLIENT_ID=""
IDUZ_CLIENT_SECRET=""
IDUZ_REDIRECT_URI="https://sifat.uz/auth/iduz/callback"

# Kafka (ixtiyoriy — yo'q bo'lsa tizim degraded rejimda ishlaydi)
KAFKA_BROKERS="localhost:9092"

# OpenAI (ixtiyoriy — NL Interface LLM boyitish uchun)
OPENAI_API_KEY=""

# ─── Phase 5: FCM push (NOTIF-02) + SMTP email (NOTIF-03) ──────────────────
# Plan 05-01 Task 2 — fail-CLOSED in production. When NODE_ENV=production and
# ANY of FCM_SERVICE_ACCOUNT_KEY_PATH / SMTP_HOST / SMTP_USER / SMTP_PASS /
# SMTP_FROM is missing, _assertEnvVars throws at boot. In dev/test, missing
# values trigger DEV_FCM_STUB / DEV_MAIL_STUB banners (push + email no-op).

# Path to Firebase service-account JSON. Generate in Firebase Console →
# Project Settings → Service Accounts → Generate new private key. In production
# mount the file via Vault file projection; never bake the JSON into the image.
FCM_SERVICE_ACCOUNT_KEY_PATH=

# Public half of the Firebase VAPID keypair (Firebase Console → Cloud Messaging
# → Web Push certificates). Consumed by frontend messaging.getToken({ vapidKey }).
NEXT_PUBLIC_FCM_VAPID_KEY=

# Firebase web SDK init (frontend). All NEXT_PUBLIC_* are baked into the
# browser bundle — these are PUBLIC by design (Firebase scoping is server-side).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# SMTP relay (Unicon.uz/TIF DC or operator-supplied per OQ-1)
SMTP_HOST=
SMTP_PORT=587            # 587 STARTTLS (default) or 465 implicit TLS
SMTP_SECURE=false        # 'true' only for port 465
SMTP_USER=
SMTP_PASS=               # Vault secret in production — never .env.prod
SMTP_FROM="SIFAT LIBRARY <noreply@sifat.uz>"

# CSV of super-admin recipients used when a User.email row is NULL (per Q7
# user decision): alert digests, demo requests, monthly reports go here.
ADMIN_NOTIFICATION_EMAILS=admin@sifat.uz

# Plan 05-05 T3 (ALERT-06) — CSV of super-admin phone numbers for SYSTEM_DOWN
# smoke tests. POST /admin/system-down-test reads this CSV and enqueues one
# SMS per recipient via Eskiz. NOTE: ALERT-06 SYSTEM_DOWN detection requires
# an EXTERNAL watchdog (UptimeRobot/BetterStack/Pingdom hitting /health) —
# Phase 5 ships only the receive path. See 05-05-SUMMARY.md.
ADMIN_SMS_RECIPIENTS=+998901234567,+998902223344

# ─── Phase 6: MinIO storage (Plan 06-01) ───────────────────────────────────
# Backend-controlled bucket names below — never user-supplied. MinIO endpoint
# is the docker container shipped via docker-compose. In production these
# point at the Unicon.uz / TIF DC MinIO cluster (server-localisation per
# CLAUDE.md §VIII.3). When MINIO_ENDPOINT is empty the dev no-op kicks in and
# any putObject / presignedGetUrl call throws "MinIO not configured" — NEVER
# silent success.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DEBATES=debate-media
MINIO_BUCKET_BOOKCORNERS=bookcorner-photos
MINIO_BUCKET_READINGHOURS=readinghour-media

# ─── Plan 06-06 ORG-03: QR HMAC secret (Reading Hour rotating QR) ───────────
# 32-byte base64 random. Used by ReadingHourService.generateQrToken to sign a
# 5-minute window bucket (rotates every 5 min per CLAUDE.md §VIII.1 dynamic QR
# + §XV.R22 screenshot-replay defence). Constant-time compare via
# crypto.timingSafeEqual; tolerates one prior window for clock-drift.
# Production: store in Vault, rotate quarterly, NEVER log.
QR_HMAC_SECRET="change-me-qr-hmac-secret-32-bytes-base64"

# App
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:3000"
