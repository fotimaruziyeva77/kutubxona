# Recommended LOCAL DEV values. Copy to apps/backend/.env
#
# This file enables the DEV OTP bypass so you can register and reset
# passwords without configured Eskiz SMS credentials. The bypass is
# guarded inside AuthService by a fail-CLOSED NODE_ENV allowlist and
# at boot by a loud startup banner — see apps/backend/src/main.ts.

DATABASE_URL="postgresql://sifat:sifat@localhost:55432/sifat?schema=public"
REDIS_URL="redis://localhost:56379"
ELASTICSEARCH_NODE="http://localhost:9200"
# ES konteyneri yo'q bo'lsa false qiling: aks holda har qidiruv o'lik portga ulanib ~3.5 s kutadi (Prisma fallback baribir ishlaydi)
# ELASTICSEARCH_ENABLED=false

# JWT
JWT_SECRET="dev-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"

# SMS (Eskiz.uz yoki SMS.uz) — empty in dev because bypass is on
SMS_PROVIDER_TOKEN=""
SMS_PROVIDER_URL="https://notify.eskiz.uz/api"

# DEV ONLY — when 'true' AND NODE_ENV in {development,test,dev}, the
# OTP send/verify endpoints skip SMS and auto-accept any code. Set to
# 'false' (or unset) to use live Eskiz OTP. NEVER use in production.
DEV_OTP_BYPASS=true

# Mutolaa.uz webhook imzo kaliti (server-to-server)
MUTOLAA_WEBHOOK_SECRET="dev-mutolaa-secret"

# Payme — dev sandbox
PAYME_MERCHANT_ID=""
PAYME_SECRET_KEY=""
PAYME_TEST_KEY=""

# Click — dev sandbox
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""

# Sentry — disabled in dev
SENTRY_DSN=""

# Kafka — optional in dev
KAFKA_BROKERS="localhost:9092"

# OpenAI — optional
OPENAI_API_KEY=""

# App
NODE_ENV="development"
PORT=4000
FRONTEND_URL="http://localhost:3000"
