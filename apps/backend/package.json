{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node --transpile-only prisma/seed.ts",
    "lint": "eslint src",
    "test": "jest",
    "test:cov": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint:replica": "node -e \"const fs=require('fs');const s=fs.readFileSync('src/modules/admin/admin.service.ts','utf8');const r=/this\\.prisma\\.(user|library|book|bookTransaction|readingIndex|aiAuditLog)\\.(count|groupBy|aggregate|findMany|findFirst|findUnique)\\b/g;const m=s.match(r);if(m&&m.length){console.error('FAIL: heavy read on this.prisma (must use this.replica):\\n'+m.join('\\n'));process.exit(1)}else{console.log('lint:replica OK (0 heavy reads on primary)')}\""
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.19.1",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.22",
    "@nestjs/elasticsearch": "^10.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/websockets": "^10.4.22",
    "@prisma/client": "^5.14.0",
    "@sentry/node": "^10.51.0",
    "@sentry/profiling-node": "^10.51.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@sparticuz/chromium": "^130.0.0",
    "@types/multer": "^2.0.0",
    "@types/qrcode": "^1.5.6",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.8.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "file-type": "^19.6.0",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "kafkajs": "^2.2.4",
    "minio": "^8.0.7",
    "multer": "^2.1.1",
    "node-vault": "^0.12.0",
    "nodemailer": "^10.3.1",
    "prom-client": "^15.1.3",
    "puppeteer-core": "^25.16.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.7.5",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.2",
