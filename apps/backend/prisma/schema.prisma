// ── Phase 6 (Plan 06-01) — schema additions ────────────────────────────────

// FAM-03 — explicit family-membership join date. Backfilled with User.createdAt
// for legacy rows. Sole source of truth for the 30-day waiting-period filter
// (CLAUDE.md §IV.4).
//
// Plan 06-01-fix audit-HIGH: userId was @unique which enforced "1 user = 1
// LIFETIME row" (not "1 user = 1 ACTIVE family") — after leaving family X
// the user could NEVER join family Y because the create would hit a
// P2002 unique-violation. @unique dropped; uniqueness of the ACTIVE
// row is enforced by a Postgres partial unique index added in the
// migration 20260608000004_phase6_family_membership_partial_unique
// (CREATE UNIQUE INDEX ... ON FamilyMembership(userId) WHERE leftAt IS
// NULL). leaveFamily MUST stamp leftAt (not just User.familyId=null) for
// rejoin to work AND for computeFamilyRatings.where.leftAt:null to be
// accurate.
model FamilyMembership {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation("FamilyMembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  familyId String
  family   Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  @@index([userId])
  @@index([familyId])
  @@index([joinedAt])
}

// FAM-06 — tuman-admin-approved address change. PENDING|APPROVED|REJECTED.
// Endpoints land in Plan 06-03.
model AddressChangeRequest {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation("AddressChangeRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  fromAddressId String?
  toAddressId   String
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reason        String?
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, status])
  @@index([status, createdAt])
}

// SCH-04 — bcrypt-hashed parent SMS consent deep-link token. 48h TTL.
// Plumbing only; wired in Plan 06-04.
model ClubMemberConsentToken {
  id           String     @id @default(cuid())
  clubMemberId String     @unique
  clubMember   ClubMember @relation(fields: [clubMemberId], references: [id], onDelete: Cascade)
  tokenHash    String     @unique
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime   @default(now())

  @@index([expiresAt])
}

// SCH-05 — Debate media-audit trail (MinIO key + mimeType + size + uploader).
model DebateMedia {
  id           String   @id @default(cuid())
  debateId     String
  debate       Debate   @relation(fields: [debateId], references: [id], onDelete: Cascade)
  url          String
  mimeType     String
  sizeBytes    Int
  thumbnailUrl String?
  uploadedById String
  uploadedAt   DateTime @default(now())

  @@index([debateId])
}

// ORG-03 — ReadingHour media-audit trail.
model ReadingHourMedia {
  id            String      @id @default(cuid())
  readingHourId String
  readingHour   ReadingHour @relation(fields: [readingHourId], references: [id], onDelete: Cascade)
  url           String
  mimeType      String
  sizeBytes     Int
  uploadedById  String
  uploadedAt    DateTime    @default(now())

  @@index([readingHourId])
}

// ORG-04 — Kitob burchagi verification log (admin + photo per refresh cycle).
model BookCornerVerification {
  id           String     @id @default(cuid())
  bookCornerId String
  bookCorner   BookCorner @relation(fields: [bookCornerId], references: [id], onDelete: Cascade)
  verifiedById String
  photoUrls    String[]   @default([])
  note         String?
  createdAt    DateTime   @default(now())

  @@index([bookCornerId, createdAt])
}
