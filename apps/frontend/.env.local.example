# Recommended LOCAL DEV values. Copy to apps/frontend/.env.local
#
# Enables the DEV OTP UI bypass so the register and forgot-password
# flows collapse to phone+password single cards. Build is refused if
# this flag is true with NODE_ENV=production or NEXT_PHASE=phase-
# production-build — see apps/frontend/next.config.js guard.

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# DEV ONLY — collapses register wizard step 1 and login forgot-password
# flow to phone+password (skips OTP UI). Must be 'false' or unset in
# any non-dev build. See next.config.js for the build-time guard.
NEXT_PUBLIC_DISABLE_OTP=true
