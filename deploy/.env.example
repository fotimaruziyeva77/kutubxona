# ─────────────────────────────────────────────────────────────────────────────
# SIFAT LIBRARY — pilot server sozlamalari (deploy/.env)
# install.sh bu faylni nusxalab, CHANGE_ME qiymatlarini tasodifiy sirlar
# bilan almashtiradi. .env HECH QACHON gitga qo'shilmaydi.
# ─────────────────────────────────────────────────────────────────────────────

# ── Manzil ──────────────────────────────────────────────────────────────────
PUBLIC_URL=https://sifatlibrary.uz
SITE_ADDRESS=sifatlibrary.uz
WWW_ADDRESS=www.sifatlibrary.uz
HTTP_PORT=80
HTTPS_PORT=443

# ── Ichki sirlar (install.sh avtomatik to'ldiradi) ──────────────────────────
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
VAULT_TOKEN=CHANGE_ME
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
QR_TOKEN_SECRET=CHANGE_ME
QR_HMAC_SECRET=CHANGE_ME
MUTOLAA_WEBHOOK_SECRET=CHANGE_ME

# ── MinIO bucketlar ─────────────────────────────────────────────────────────
MINIO_BUCKET_DEBATES=debates
MINIO_BUCKET_BOOKCORNERS=bookcorners
MINIO_BUCKET_READINGHOURS=readinghours

# ── Tashqi integratsiyalar ──────────────────────────────────────────────────
# Kalitlar hali yo'q. "not-configured" — backend ishga tushadi, lekin shu
# funksiyalar ishlamaydi (SMS, to'lov, push, email). Kalit kelganda shu
# yerga yozing va:  docker compose up -d backend

# Eskiz.uz (SMS: ro'yhatdan o'tish OTP, eslatmalar)
ESKIZ_EMAIL=not-configured
ESKIZ_PASSWORD=not-configured
ESKIZ_FROM=4546

# Payme
PAYME_MERCHANT_ID=not-configured
PAYME_SECRET_KEY=not-configured
PAYME_LOGIN=Paycom

# Click
CLICK_MERCHANT_ID=not-configured
CLICK_SECRET_KEY=not-configured
CLICK_SERVICE_ID=not-configured

# Email (SMTP)
SMTP_HOST=smtp.not-configured.invalid
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=not-configured
SMTP_PASS=not-configured
SMTP_FROM=noreply@sifatlibrary.uz

# Firebase push. Kalit kelganda: faylni deploy/secrets/fcm.json ga qo'ying va
# qiymatni /app/apps/backend/secrets/fcm.json ga o'zgartiring.
FCM_SERVICE_ACCOUNT_KEY_PATH=disabled

# ID.UZ (davlat xizmatchilari uchun OneID kirish) — shartnoma bo'lgach
IDUZ_CLIENT_ID=not-configured
IDUZ_CLIENT_SECRET=not-configured
IDUZ_REDIRECT_URI=https://sifatlibrary.uz/auth/iduz/callback

# Bank rekvizitlari tekshirilmaguncha faktura PDF'da ko'rsatilmaydi
BANK_REKVIZIT_VERIFIED=false

# Xatolarni kuzatish (ixtiyoriy)
SENTRY_DSN=
