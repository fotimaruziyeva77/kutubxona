{
  "name": "sifatlibrary",
  "private": true,
  "version": "0.1.0",
  "description": "SIFAT LIBRARY monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/backend\" \"npm run dev -w apps/frontend\"",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "multer": "2.5.0",
    "body-parser": "1.20.9",
    "@grpc/grpc-js": "^1.14.6",
    "js-yaml@^4": "4.3.2",
    "lodash": "^4.18.1",
    "browserslist": "^4.29.5",
    "basic-ftp": "^6.2.3"
  }
}
